# Copy to `api/.env`. Every value below is the default, except where a
# comment says otherwise — the service credentials have none.

PORT=3130
LOG_LEVEL=debug

# --- identity ---------------------------------------------------------------
# pistis, the aether-zone authorization server. mneme verifies its tokens and
# issues none of its own, so there is no signing key here — only the issuer to
# check them against. Must match the `iss` claim exactly.
OAUTH_ISSUER=http://localhost:3001

# `aud` every accepted token must carry, and where pistis publishes its keys.
# Both are derived from the issuer when unset, which is what a normal
# deployment wants.
# OAUTH_AUDIENCE=
# OAUTH_JWKS_URI=

# --- the vector store -------------------------------------------------------
# Qdrant. The workspace compose file publishes it on 6343 — 6333 is the
# container's port, remapped because the default is commonly taken.
QDRANT_URL=http://localhost:6343
# Only needed for a Qdrant that requires one; the local container does not.
# QDRANT_API_KEY=

# One collection holds every tenant, with `organizationId` filtered on each
# query. Changing this name starts an empty memory rather than migrating.
MNEME_COLLECTION=mneme

# --- embedding --------------------------------------------------------------
# WITHOUT A KEY, mneme embeds locally with a hashing provider that matches
# *words* rather than meaning — enough to run and test the pipeline, and not
# good enough for anything real. The boot log says so when it happens.
# OPENAI_API_KEY=

# Changing the model invalidates every vector already stored: it is a
# re-index, not a migration.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Characters per chunk, and how much of the previous each one repeats. The
# overlap is what stops a passage that straddles a cut being findable in
# neither half.
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# --- reading uploaded files -------------------------------------------------
# loculus, the object store service. When somebody uploads a document, loculus
# announces it and mneme fetches the bytes from here to index them. Internal:
# reached server to server, not by a browser.
LOCULUS_URL=http://localhost:3111
# How long to wait for loculus to sign a URL. NOT the budget for reading the
# object itself, which takes as long as the object is large.
LOCULUS_TIMEOUT_MS=5000

# mneme's OWN identity, which is a different thing from OAUTH_ISSUER above.
# That one makes mneme a resource server, verifying tokens other people
# present. These make it a client: indexing begins when an event arrives, long
# after the request that caused it, so there is nobody's token to borrow and
# mneme has to present its own.
#
# NOT DEFAULTS — unset, mneme cannot read objects at all. The listener says so
# once per message rather than refusing to boot, because search and the HTTP
# ingest path work perfectly well without loculus.
#
# The client must be registered in pistis for the `client_credentials` grant
# and hold `objects:read:any`, the scope that lets a service read a file
# another client uploaded. Running pistis with OAUTH_DEV_SEED=true registers
# exactly that, as the id and secret below.
OAUTH_CLIENT_ID=mneme
OAUTH_CLIENT_SECRET=mneme-secret
# pistis's token endpoint. Derived from the issuer when unset.
# OAUTH_TOKEN_URI=

# --- events -----------------------------------------------------------------
# The shared broker. Every aether-zone service publishes to this one exchange;
# a broker of mneme's own would leave it subscribed to nothing. The compose
# file publishes it on 5682.
RABBITMQ_URI=amqp://aether-zone:Ch4nG3M3!@localhost:5682
RABBITMQ_EXCHANGE=aether-zone
# mneme waits for the broker: a memory that starts without its subscription
# looks healthy while remembering nothing, and missed events are not replayed.
RABBITMQ_CONNECT_TIMEOUT_MS=10000
