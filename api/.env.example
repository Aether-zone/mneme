# Copy to `api/.env`. Every value below is the default.

PORT=3130
LOG_LEVEL=debug

# pistis, the aether-zone authorization server. mneme verifies its tokens and
# issues none of its own, so there is no signing key here — only the issuer to
# check them against. Must match the `iss` claim exactly.
OAUTH_ISSUER=http://localhost:3001

# `aud` every accepted token must carry. pistis defaults its audience to its own
# issuer, so leaving this unset is correct for a normal deployment.
# OAUTH_AUDIENCE=

# Where pistis publishes its signing keys. Derived from the issuer per RFC 8414
# when unset, which is what a normal deployment wants.
# OAUTH_JWKS_URI=
