# Copy to `web/.env`. mneme signs in through pistis, the aether-zone
# authorization server; there is no account store here. These values register
# the console as an OAuth client of it, and the client has to exist in pistis
# first with this exact redirect URI.

# The pistis API: mints the tokens, publishes the keys the mneme api checks them
# against. Must match the `iss` claim exactly.
OAUTH_ISSUER=http://localhost:3001

# The pistis *web* app's consent screen. Not the same origin as the issuer:
# `GET /api/oauth/authorize` answers with JSON describing the pending request
# rather than redirecting, so a browser has to be sent to the app that renders
# the consent UI, not to the API.
OAUTH_CONSENT_URL=http://localhost:3002/login

OAUTH_CLIENT_ID=mneme
# Handed out once when the client is registered in pistis, and stored there only
# as a bcrypt hash — if it is lost it has to be rotated, not recovered.
OAUTH_CLIENT_SECRET=

# Must be registered against the client in pistis; it refuses any other value.
OAUTH_REDIRECT_URI=http://localhost:3131/api/auth/callback

# `profile` is what /oauth/userinfo needs to return a name at all;
# `organizations` is what puts the `orgs` claim on the token that the sidebar's
# switcher reads.
OAUTH_SCOPES=profile email organizations

# The mneme api, for server-side calls carrying the access token.
MNEME_API_URL=http://localhost:3130
